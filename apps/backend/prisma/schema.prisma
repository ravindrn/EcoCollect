generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum Role {
  CITIZEN
  DRIVER
  ADMIN
}



// User & CitizenProfile

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CITIZEN)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  citizenProfile CitizenProfile?
  complaints     Complaint[]
  vehicles       Vehicle[]
  routeAlerts    RouteAlert[]

  communityUpdates CommunityUpdate[]
  communityReactions CommunityReaction[]
  communityComments CommunityComment[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model CitizenProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  fullName     String   @map("full_name")
  phone        String?
  address      String?
  wardDivision String?  @map("ward_division")
  areaId String? @map("area_id") @db.Uuid
  area   Area?   @relation(fields: [areaId],references: [id],onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([wardDivision])
  @@index([areaId])
  @@map("citizen_profiles")
}

model HealthCheck {
  id        String   @id @default(uuid())
  checkedAt DateTime @default(now())

  @@map("health_checks")
}

model Area {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  citizenProfiles CitizenProfile[]
  communityUpdates CommunityUpdate[]

  @@map("areas")
}


model CommunityUpdate {
  id        String   @id @default(uuid()) @db.Uuid
  content   String   @db.Text
  userId    String   @map("user_id") @db.Uuid
  areaId    String   @map("area_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  area      Area                @relation(fields: [areaId], references: [id], onDelete: Restrict)
  reactions CommunityReaction[]
  comments  CommunityComment[]

  @@index([areaId, createdAt])
  @@index([userId, createdAt])
  @@map("community_updates")
}

model CommunityReaction {
  id        String   @id @default(uuid()) @db.Uuid
  updateId  String   @map("update_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  update CommunityUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One Helpful reaction per user for each update.
  @@unique([updateId, userId])
  @@index([userId])
  @@map("community_reactions")
}

model CommunityComment {
  id        String   @id @default(uuid()) @db.Uuid
  content   String   @db.Text
  updateId  String   @map("update_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  update CommunityUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updateId, createdAt])
  @@index([userId])
  @@map("community_comments")
}



enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  title       String
  description String               @db.Text
  priority    AnnouncementPriority @default(NORMAL)
  status      AnnouncementStatus   @default(DRAFT)
  publishedAt DateTime?            @map("published_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("announcements")
}

enum ComplaintStatus {
  PENDING
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model Complaint {
  id          String          @id @default(uuid()) @db.Uuid
  category    String
  title       String          @db.VarChar(100)
  description String          @db.Text

  isAnonymous Boolean         @default(false) @map("is_anonymous")
  status      ComplaintStatus @default(PENDING)

  userId      String?         @map("user_id") @db.Uuid
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  latitude    Float?
  longitude   Float?
  photoUrl    String?         @map("photo_url")

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([category])
  @@map("complaints")
}

model Vehicle {
  id          String            @id @default(uuid()) @db.Uuid
  plateNumber String            @unique @map("plate_number")
  name        String?
  driverId    String?           @map("driver_id") @db.Uuid
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  driver      User?             @relation(fields: [driverId], references: [id], onDelete: SetNull)
  locations   VehicleLocation[]
  routeAlerts RouteAlert[]

  @@index([isActive])
  @@map("vehicles")
}

model VehicleLocation {
  id         String   @id @default(uuid()) @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  latitude   Float
  longitude  Float
  speed      Float?
  heading    Float?
  recordedAt DateTime @default(now()) @map("recorded_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
  @@map("vehicle_locations")
}

enum RouteAlertKind {
  OUTSIDE
  INSIDE
}

model RouteAlert {
  id         String         @id @default(uuid()) @db.Uuid
  vehicleId  String         @map("vehicle_id") @db.Uuid
  driverId   String         @map("driver_id") @db.Uuid
  kind       RouteAlertKind
  routeName  String?        @map("route_name")
  latitude   Float
  longitude  Float
  recordedAt DateTime       @default(now()) @map("recorded_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  User    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
  @@index([recordedAt])
  @@map("route_alerts")
}
